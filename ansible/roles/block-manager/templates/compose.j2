services:
  nginx_bm:
    image: {{ NGINX_IMAGE }}
    restart: unless-stopped
    depends_on:
      - q_server_bm
      - block_manager
    networks:
      - ackinacki-net
    environment:
      - MESSAGE_ROUTER_ADDRESS=block_manager:{{ BM_API_PORT }}
      - Q_SERVER_ADDRESS=q_server_bm:3000
      - NODE_API_ADDRESS=block_manager:{{ BM_API_PORT }}
      - BLOCK_MANAGER_API=block_manager:{{ BM_API_PORT }}
    ports:
      - target: 80
{% if NGINX_IP == "public" %}
        host_ip: {{ HOST_PUBLIC_IP }}
{% elif NGINX_IP == "private" %}
        host_ip: {{ HOST_PRIVATE_IP }}
{% else %}
        host_ip: {{ NGINX_IP }}
{% endif %}
        published: {{ NGINX_PORT }}
        protocol: tcp

  q_server_bm:
    image: {{ GQL_IMAGE }}
    entrypoint: []
    restart: unless-stopped
    environment:
      NODE_VERBOSE: 1
      BM_API_SOCKET: block_manager:{{ BM_REST_API_PORT }}
{% set otel_node_id = BM_ID | default(0) | string %}{% if NODE_GROUP_ID is defined and NODE_GROUP_ID %}{% set otel_node_id = NODE_GROUP_ID ~ '-' ~ otel_node_id %}{% endif %}
      OTEL_RESOURCE_ATTRIBUTES: service.namespace={{ NETWORK_NAME }},service.instance.id={{ otel_node_id }},host.name={{ OTEL_MY_HOST_NAME | default(ansible_host) }}
{% if OTEL_COLLECTOR is defined and OTEL_COLLECTOR %}
      OTEL_EXPORTER_OTLP_METRICS_ENDPOINT: {{ OTEL_COLLECTOR }}
      OTEL_EXPORTER_OTLP_METRICS_PROTOCOL: {{ OTEL_COLLECTOR_PROTO | default('grpc') }}
{% endif %}
      OTEL_SERVICE_NAME: {{ OTEL_SERVICE_NAME | default(TEST_NAME ~ '-' ~ COMMIT_HASH) }}
    command:
      - bash
      - -c
      - >
        exec gql-server -d ./data/bm-archive.db -l 0.0.0.0:3000 --config /workdir/conf/config.yaml >> /logsdir/qserver.log 2>&1
    expose:
      - "3000"
    ports:
      - {{ HOST_PRIVATE_IP }}:{{ Q_SERVER_MAPPED_PORT }}:3000
    volumes:
      - {{ BM_DATA_DIR }}/workdir:/workdir/data
      - {{ BM_LOGS_DIR }}:/logsdir
      - ./conf:/workdir/conf
    networks:
      - ackinacki-net
    depends_on:
      # Not just started: block-manager runs its migrations first and creates
      # bm-history-proofs.db, which gql-server attaches at startup.
      block_manager:
        condition: service_healthy

  block_manager:
    image: {{ BM_IMAGE }}
    entrypoint: []
    restart: unless-stopped
    init: true
    environment:
        RUST_BACKTRACE: 1
        RUST_LOG: debug
        NODE_VERBOSE: 1
        SQLITE_PATH: ./data
        STREAM_SRC_URL: https://{{ NODE_IP }}:{{ BM_NODE_STREAM_PORT }}
        DEFAULT_BP: {{ NODE_IP }}:{{ BM_NODE_PORT }}
        BM_OWNER_WALLET_PUBKEY: {{ BM_OWNER_WALLET_PUBKEY }}
        BM_ISSUER_KEYS_FILE: /bm-configs/{{ BM_SIGNER_KEYS | basename }}
        TOKEN_TTL: {{ BM_TOKEN_TTL }}
        BK_API_TOKEN: {{ BK_API_TOKEN }}
        REST_API: 0.0.0.0:{{ BM_REST_API_PORT }}
        READINESS_MAX_BLOCK_AGE_SECS: {{ BM_READINESS_MAX_BLOCK_AGE_SECS }}
{% set otel_node_id = BM_ID | default(0) | string %}{% if NODE_GROUP_ID is defined and NODE_GROUP_ID %}{% set otel_node_id = NODE_GROUP_ID ~ '-' ~ otel_node_id %}{% endif %}
        OTEL_RESOURCE_ATTRIBUTES: service.namespace={{ NETWORK_NAME }},service.instance.id={{ otel_node_id }},host.name={{ OTEL_MY_HOST_NAME | default(ansible_host) }}
{% if OTEL_COLLECTOR is defined and OTEL_COLLECTOR %}
        OTEL_EXPORTER_OTLP_METRICS_ENDPOINT: {{ OTEL_COLLECTOR }}
        OTEL_EXPORTER_OTLP_METRICS_PROTOCOL: {{ OTEL_COLLECTOR_PROTO | default('grpc') }}
{% endif %}
        OTEL_SERVICE_NAME: {{ OTEL_SERVICE_NAME | default(TEST_NAME ~ '-' ~ COMMIT_HASH) }}
    command:
      - bash
      - -c
      - >
        migration-tool -p ./data/bm-archive.db --block-manager
        && migration-tool -p ./data/bm-schema.db --block-manager
        && exec {{ BM_BINARY }} >> /logsdir/block-manager.log 2>&1
    healthcheck:
      # Healthy once block-manager is past its migrations, serves HTTP (it
      # starts before the databases open) and bm-history-proofs.db exists (it
      # creates the file on its first start, and the file appears only with its
      # schema). Any HTTP status counts: /v2/readiness
      # answers 503 while no fresh blocks arrive, and a stalled network must
      # not keep gql-server down. bash, not sh: the image has no curl, the
      # request goes over /dev/tcp.
      test:
        - CMD
        - bash
        - -c
        - >-
          exec 3<>/dev/tcp/127.0.0.1/{{ BM_REST_API_PORT }}
          && printf 'GET /v2/readiness HTTP/1.0\r\n\r\n' >&3
          && read -r -t 3 status <&3
          && [[ $$status == HTTP/* ]]
          && test -f /workdir/data/bm-history-proofs.db
      interval: 5s
      timeout: 5s
      retries: 3
      start_period: {{ BM_HEALTHCHECK_START_PERIOD }}
    expose:
      - {{ BM_API_PORT }}
    ports:
      - "{{ BM_API_BIND }}:{{ BM_API_PORT }}:{{ BM_API_PORT }}/tcp"
      - "{{ BM_REST_API_BIND }}:{{ BM_REST_API_PORT }}:{{ BM_REST_API_PORT }}/tcp"
    volumes:
      - {{ BM_DATA_DIR }}/workdir:/workdir/data
      - {{ BM_DIR }}/bm-configs:/bm-configs
      - {{ BM_LOGS_DIR }}:/logsdir
    networks:
      - ackinacki-net

  staking_bm:
    image: {{ STAKING_BM_IMAGE }}
    restart: unless-stopped
    entrypoint: []
    command:
      - /bin/bash
      - -c
      - >
        tvm-cli config -g --url "{{ TVM_ENDPOINT }}"
        && chmod 755 /staking/bm_staking.sh
        && exec /staking/bm_staking.sh -p {{ STAKING_TIME }} /bm-configs/{{ BM_WALLET_KEYS | basename }}
    volumes:
      - {{ BM_DIR }}/bm-configs:/bm-configs
    depends_on:
      - block_manager
    networks:
      - ackinacki-net

  logrotate:
    image: {{ LOGROTATE_IMAGE }}
    restart: unless-stopped
    environment:
      - CRON_SCHEDULE="58 * * * *"
    volumes:
      - {{ BM_LOGS_DIR }}:/logsdir
      - ./logrotate.sh:/logrotate.sh
    command: [ "/bin/bash", "/logrotate.sh" ]
    init: true

networks:
  ackinacki-net:
    name: ackinacki-net
{% if EXTERNAL_NET %}
    external: true
{% endif %}

