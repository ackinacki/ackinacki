services:
  caddy:
    build:
      context: .
      dockerfile: Dockerfile
    image: caddy-ratelimit:2.8.4
    ports:
      - "${HOST_PUBLIC_IP}:80:80"
      - "${HOST_PUBLIC_IP}:443:443"
    volumes:
      - ./caddy:/etc/caddy
      - ./data:/data
    environment:
      - CADDY_EMAIL=${CADDY_EMAIL}
    restart: unless-stopped
    # Safety margin for upstream connection churn (all upstream conns share one src IP/dst port)
    sysctls:
      net.ipv4.tcp_tw_reuse: 1
      net.ipv4.ip_local_port_range: "10000 65535"
{% if OTEL_COLLECTOR is defined and OTEL_COLLECTOR %}
    expose:
      - "2019"
{% endif %}
    networks:
      ackinacki-net:
        aliases:
          - caddy-{{ HOST_PUBLIC_IP | replace('.', '-') }}

{% if OTEL_COLLECTOR is defined and OTEL_COLLECTOR %}
  otel-collector:
    image: {{ OTEL_COLLECTOR_IMAGE | default('otel/opentelemetry-collector-contrib:0.115.1') }}
    volumes:
      - ./otel-collector-config.yaml:/etc/otelcol-contrib/config.yaml
    restart: unless-stopped
    networks:
      - ackinacki-net
    depends_on:
      - caddy
{% endif %}

networks:
  ackinacki-net:
    name: ackinacki-net
{% if EXTERNAL_NET is defined and EXTERNAL_NET is true %}
    external: true
{% endif %}
